html[lang="ja"] {
  head {
    meta[charset="UTF-8"];
    meta[name="viewport", content="width=device-width, initial-scale=1"];
    meta[name="description", content="Matraのparser、renderer、domain packageを一覧できます。"];
    meta[name="theme-color", content="#101814"];
    title {
      "公式パッケージ — Matra"
    }
    link[rel="stylesheet", href="/app.css"];
  }
  body {
    main {
      section.hero {
        div.shell {
          div.hero-copy {
            p.eyebrow {
              "PACKAGES"
            }
            h1 {
              "公式パッケージ"
            }
            p.lede {
              "Matraのparser、renderer、domain packageを一覧できます。"
            }
            div.docs-card-list {
              a.docs-card[href="https://github.com/matralang/matra/tree/main/packages/core"] {
                span {
                  "01"
                }
                div {
                  h2 {
                    "@matra/core"
                  }
                  p {
                    "AST、parser、visitor、transformer。"
                  }
                }
              }
              a.docs-card[href="https://github.com/matralang/matra/tree/main/packages/command"] {
                span {
                  "02"
                }
                div {
                  h2 {
                    "@matra/command"
                  }
                  p {
                    "外部commandの計画、認可、構造化実行。"
                  }
                }
              }
              a.docs-card[href="https://github.com/matralang/matra/tree/main/packages/html"] {
                span {
                  "03"
                }
                div {
                  h2 {
                    "@matra/html"
                  }
                  p {
                    "Matra ASTのHTML renderer。"
                  }
                }
              }
              a.docs-card[href="https://github.com/matralang/matra/tree/main/packages/graphics"] {
                span {
                  "04"
                }
                div {
                  h2 {
                    "@matra/graphics"
                  }
                  p {
                    "Graphics domainの表現と描画。"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
