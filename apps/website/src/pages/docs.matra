html[lang="ja"] {
  head {
    meta[charset="UTF-8"];
    meta[name="viewport", content="width=device-width, initial-scale=1"];
    meta[name="description", content="言語仕様、Playground、作例、パッケージへの入口です。"];
    meta[name="theme-color", content="#101814"];
    title {
      "Matraを使う — Matra"
    }
    link[rel="stylesheet", href="/app.css"];
  }
  body {
    header.site-header {
      div.shell.nav-shell {
        a.brand[href="/"] {
          span.brand-mark {
            "M"
          }
          span {
            "Matra"
          }
        }
        nav.site-nav[aria-label="メインナビゲーション"] {
          a[href="/docs/"] {
            "Docs"
          }
          a[href="/spec/"] {
            "Specification"
          }
          a[href="/play/"] {
            "Playground"
          }
          a[href="https://github.com/matralang/matra"] {
            "GitHub"
          }
        }
      }
    }
    main {
      section.hero {
        div.shell {
          div.hero-copy {
            p.eyebrow {
              "DOCUMENTATION"
            }
            h1 {
              "Matraを使う"
            }
            p.lede {
              "言語仕様、Playground、作例、パッケージへの入口です。"
            }
            div.docs-card-list {
              a.docs-card[href="/spec/"] {
                span {
                  "01"
                }
                div {
                  h2 {
                    "Language Specification"
                  }
                  p {
                    "言語のデータモデル、AST、文法、parser契約。"
                  }
                }
              }
              a.docs-card[href="/play/"] {
                span {
                  "02"
                }
                div {
                  h2 {
                    "Playground"
                  }
                  p {
                    "Matra sourceをブラウザで試す。"
                  }
                }
              }
              a.docs-card[href="/examples/"] {
                span {
                  "03"
                }
                div {
                  h2 {
                    "Examples"
                  }
                  p {
                    "分野ごとの利用例を見る。"
                  }
                }
              }
              a.docs-card[href="/packages/"] {
                span {
                  "04"
                }
                div {
                  h2 {
                    "Packages"
                  }
                  p {
                    "公式パッケージとAPIを探す。"
                  }
                }
              }
            }
          }
        }
      }
    }
    footer.site-footer {
      div.shell.footer-grid {
        div {
          strong {
            "Matra"
          }
          p {
            "Structure first. Domain later."
          }
        }
        p {
          "Matra Specification v0.2"
        }
      }
    }
  }
}
